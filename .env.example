# Copy to .env for local development (`pnpm dev`, `pnpm test`). Never commit .env.
DATABASE_URL=postgresql://shop:shop@127.0.0.1:55432/shop
TEST_DATABASE_URL=postgresql://shop:shop@127.0.0.1:55432/shop_test
OPERATOR_TOKEN=demo-operator-token-change-me-0123456789
PORT=3000
LOG_LEVEL=info

